  Object.assign(strings["de-DE"], {"ea8b5db90463595c87a4e2b4d7d91a014a86fd72":"Da ist etwas schiefgelaufen","fcc3db92b4e7b3ca4eaecc599bcc56b0cc175318":"Fehler:","f54e454a5d3843e5dadc71623940d07f9fdd6bd8":"Auf Canva öffnen","39e0aaa6df8478bc5b723bad5d8f1edddb660e6c":"Designvorschau","1db4e3a5a978a80a1f374b020092fbae4e17e6c0":"Seite {0}","2fddb161631952b973216d81f5cae49bb1e545fa":"Generiertes Design","07a94cf04a82fa516d5c01bfaa14222881cc8f52":"Design ohne Titel","225934769fc7309b26395550e2f73f1a611ffa71":"Fotocollage","28fed60d84f5540c47a91ceae8459b82e3cdefe1":"Keine Designs gefunden","460ad1ac76c9445555812ade28d3fcbb0ea426a7":"Präsentation","4c2a32f05250b0a3b37597eafeec795c8af4a655":"Bericht","55a714344d60ff3bc7cf5b4e04d876b1a0a9445c":"Design-Miniaturansicht","6078acca22c4d622edc77ccc52921f62a202517f":"Einladung","66a9cea0922de214504bd83067e3fc0ea748b002":"Facebook-Titelbild","6af42a3028a3d726f6d0966a4f05fbfcf9ccc0c5":"Visitenkarte","6e9b8b013e243288508ed15beeb998e1d4174ce2":"Karte","73613be70662d8b80435626ac4e2ee892d114541":"Poster","7615f8721ad7d71af0afd88c3fbde840b14352fa":"Facebook-Post","790f1261ff17bb0597939aed0f60c12d1812a648":"Dokument","7f8172d1fa744c0d1e98d942838c67d724e4f042":"YouTube-Banner","880ab1c7f585e309b9c2139d27814b423cb8ec16":"Desktop-Hintergrund","9150ccb8ad68e33dc0c467ed8789184edc4951a8":"Deine Story","957e3943e6136bfff59e1df9495a4c91d31ecf3e":"YouTube-Miniatur","9e3e9b8a85ff36aabf4b113031f8babf57230a79":"Lebenslauf","9f80ccca2df22d0af92dfb74393be27c168aaf87":"Telefon-Hintergrundbild","b16eeaad26233ede794402ec8efbda2ffca79c3e":"Instagram-Post","b4ab580618c6122425c34f7802168303dd4ca649":"Design","b9443b025c5456adf1cfb586a1b97c3710ca0132":"Pinterest-Pin","c9794b6912aef4ea88686f04863e14041b8d87cd":"Flyer","cafaccac6247f9fca3e32f95d9d3c143c4328a87":"Logo","dad9cc24373e66d7cd7f610128bde7a8615d2f5d":"Infografik","e05b209235b44bd3ffb83255e4ce73e94246191e":"Twitter-Post","fe1e5a32f67d497de920b4b7805fb1ffbf090fde":"Postkarte","ffe6e7986e96bda32cd244ed35d49f58b164d763":"Keine Designs gefunden. Probiere eine andere Suche oder überprüfe deine Filter.","ffea396f236c26a344f246f5b5e3092ed7ba2834":"Vorschlag","491965951445caee78af692681e8f80163c7a8e7":"Generiertes Design","750c2467ff29e4b478a4c71812407774c368cef7":"Suchergebnisse","40c0a8e05f22e5ce8134b205f812a84ed719948f":"Markenkit","95ad8a6305f0ec6f45c3a34c175c6d19f3a05fe3":"Präsentationsgliederung","10983722e7352c3731a37d66185be9fd07712ea7":"Überrasch mich!","604cda0fa51d90eb175b727fc913a61671e6fa54":"Wenn du Markenkits nutzen möchtest, musst du dein Canva Konto erneut verbinden, um die erforderlichen Berechtigungen zu erteilen.","7e456ac88dd85bce33811d48e67e1b692ff3b992":"Stiltyp auswählen","7fc2c7d02b486fbc3da5794bef53058bc89c6465":"Stil","a01cbc0df20e969f1ee19b810715a7616b339c52":"Stil","b6164529a7323e625c3e01af202eca6cac260abf":"Marke anwenden","e2eb38ba2b17f573c3bed2b01d39297332177269":"Überrasch mich!","1dfaa514e33478ba7a092a58f1a5ca66e215676c":"Kurz und knapp","1f3ad8dbe4025ec34a7519728b075b2892abf26d":"Professionell","34647611c4addf4192616c8c103dbcec93bcdaef":"Elegant","34eeeb0152e31a642b2d0c3ba94a49e53b048daf":"Digital","38dfae483c93afc3800182482743bed04cbc3fb0":"Minimalistisch","38f5acc4dd4b1dca2a421b881171950f668e06aa":"Geometrisch","6067cb1bb5f10466af06f39cb449ce7e447c5f60":"Mehr als 15 Folien","6c70a312f85238bc7e8f3afafde64882cd7b546d":"5 bis 15 Folien","763679b3ee01193c36db861af5fc0bff8111c0a7":"Kurz","895352f526381153154fb2cd5c0b1ba2fb4e303d":"Natürlich","8a9d663b33704c1a98ef38839dc424407c84782c":"Ausgewogen","9385962c817ba267a90b1caeb52d884210dfefd8":"Bildung","980db4c96bbc00a60d71c2af6148b50bdbd9afd9":"Umfassend","a23e491b4b3d702423295bd9f2656fa132f9080d":"1 bis 5 Folien","b7438a64ffbce12039049015d7252a63eb2a12a7":"Informell","f1616f451b15faa57dedcbca527fb72d962e7c2e":"Modular","fff568edb20065da4f26d83b26fe46266b4018a6":"Verspielt","0694f4fe85ba1c4e93d6e6d0a3aed8046dd150a5":"Länge auswählen","1a97b1525fabc354f1a70c27b8e2b7d51414943c":"Zielgruppe","67676d76c91cbffe8a6e88370d972a7ad832056d":"Generieren","8ee459a8f343aa0a9d4025b879b923852d80eb34":"Design generieren","d0c2dab258b4f81dc9dc4314d986b4a507d5aa38":"Zielgruppe auswählen","f449d12ccee28e65a8843a9a9e1f3696e361d332":"Keine","fa668d76a86ceb24396fe06279fb9684b71c9026":"Länge","ca3c7cabb459b54b5d466d1cce4e3a3d334076cd":"Unbenanntes Markenkit","b651e5120ff2af53b24199e78456534de5d01f2a":"Es ist ein Fehler aufgetreten","f954d24e1ea694c491b5ece79f4c7c61b24ae099":"Suchergebnisse","0d932a55aa933894731eb11de1d4cfa3b3867c1b":"Versuche, ein PNG-, JPEG- oder WEBP-Format hochzuladen.","0e2b28af1821f43bd03b6e69f668380e4f185a8a":"Design anpassen","14ffa56620b4260c4e6f077c55e87ad982828988":"Canva Abonnement ansehen","16773b01365045e1bd255c78f8c8d67f4f0e29b7":"Designvorschau","1882887442ac288a0aee62cdfcc803660122c178":"Ich konnte das Bild nicht hochladen.","2f48ac19d532ccb5633b7b3816c9aad4862ffd02":"Hier ablegen","311fdc413e003844429e8abd9f1551db93379e94":"Versuche es mit einem anderen Bild.","43518a99c3ecc97fb02068f36187d3d8e508c6f1":"Zu viele Bilder hochgeladen.","53e854e02a7368b93cf97f545a0cfe8e22cb9902":"Lade immer nur 1 Bild auf einmal hoch.","5550805de7dc59777e627f6a14eeda11887ff476":"Lade eine Datei hoch, die kleiner als 20 MB ist.","6013959f924d60316d8843cd95b56f54d7be0b3b":"Die Datei ist zu groß.","63f0f32c190079d785af6169d4b69e2f8688597e":"Bitte versuche es erneut.","6f24bae8afa3ac4366e0cf17faba362ef78a017b":"Dieser Dateityp ist nicht kompatibel.","7a8b7bb6f511c3fcfab1c4311bb8d23a7d6d3f14":"Trenne zusammengefügte oder KI-generierte Designs in vollständig bearbeitbare Layouts auf, die du selbst steuerst.","7a8bc5bf9a36bf63f1a4fe12164ed26f6b2b7430":"Die Datei ist zu klein.","7f807ab43046658b13764fc360cd2a1f4ca5a9aa":"Lade eine Datei mit einer Auflösung von mindestens 200 px hoch.","80e8e3ad2290395d1035b67a4c3b2f614d7d122e":"Deine Datei wird in ein bearbeitbares Layout verwandelt. Das Generieren von Designs kann bis zu 30 Sekunden dauern.","941205410d2b5d8d664483c1cb953115c8b5624f":"Bildvorschau","9df991668a3595c39c2e0a65dc434345c9e65ea5":"Lade eine Datei mit einer Auflösung von 8096 px oder weniger hoch.","aca47d1f1c626567ac07132e84a979ef746e165d":"Breite und Höhe dürfen maximal das Dreifache des jeweils anderen Werts betragen. Versuche, dein Bild zuzuschneiden oder die Größe anzupassen.","b41278895f3b3f7831832ca5a16a030e7c1fb519":"Du hast das monatliche KI-Kontingent deines Canva Abonnements erreicht.","d197280ac680083eb9e17f2e21d21000ace2d5a6":"Dieses Bild ist zu breit oder zu hoch.","daa868bfbe39dd54d18ca00dcc7546c9f5888e78":"Die Datei ist zu groß.","dbcaf6ba6adf02344c4d543baeebc3aaac8f828e":"Unscheinbare Designs in bearbeitbare Layouts verwandeln","ebc769732e8b6e5d30b8a7d6a50d658658ff043f":"Um weiterhin mit ChatGPT designen zu können, musst du möglicherweise ein Upgrade durchführen. Weitere Optionen findest du in den Abonnementeinstellungen in Canva.","edff46869fb93010d6d2b03814a94de4ca5fb1c5":"Medien auswählen","eedd60d044c7360cb6d3f071eb4ad3497edddebf":"oder per Drag & Drop in den Editor ziehen","fab1cead5083c225bb6aea6456253df5e139dc82":"Dieses Bild konnte nicht verarbeitet werden.","0a2a295caf117f0169c47431723a04febe6a0a19":"Review and edit the outline via the chat below. When you ask for changes, Canva updates this preview by calling prepare-design-generation again with your revised outline.","847618964c808169e9ac260c824c650695be3c89":"Du kannst die Gliederung bei Bedarf unten im Chat per Texteingabe bearbeiten. Dadurch wird „prepare-design-generation“ erneut aufgerufen und die Vorschau der Gliederung wird entsprechend aktualisiert.","99b7391b2436922e8af3d5364faf4c0f2b4d4402":"Gliederung überprüfen","e07e9299d93ae924c639dc9defbce9fac6e493c2":"Review outline","371ed3a0d3fcf1e07f2ad1d3cb171e4f587f15af":"Designs konnten nicht generiert werden. Versuche es bitte später erneut.","89a94ee830eae913869fa2332b7aa426ea59117c":"Es wurden keine Designs generiert. Probiere eine andere Anfrage aus.","dc72cd876fed54b4ad66fb8ae20ef47acd941aa4":"Unerwartetes Antwortformat erhalten. Versuche es bitte später erneut.","3bb6fa2e1f7691afde1e4a249a3a0058804c7487":"Design wird fertiggestellt. {0}","571e0bfcb732bdd4f651107823d193271610d894":"Das Generieren von Designs kann bis zu 1 Minute dauern.","7dffc93456956a06337ea3e5da6d276dad632916":"Text und Abbildungen werden hinzugefügt. {0}","8ec4cff9c1542e41e5c25c732c027434593a568c":"Canva Vorlagen werden gesucht. {0}","f24fedc487af195ee38f774cc26564ab591f565c":"Deine Story wird geplant. {0}","171b8bb4c77a7480fb0e4c4b29787c30bb5eca88":"Überprüfe deine Nutzung, um zu sehen, wie viel du bisher verwendet hast und welche KI-Features dein Kontingent ausreizen.","1f35e43b9b01eebaf477295061a5ebeb0a5a32c7":"Du hast das monatliche KI-Limit deines Canva Abonnements erreicht. Du kannst in Kürze wieder generieren.","1f547fb99173dde3d5b1afe12853b20f537d6b90":"Upgrade für mehr","34b1b03f9bb0ef093be64edff26034f4b0b5e52c":"In {0, plural, one {# Minute} other {# Minuten}} kannst du wieder Inhalte generieren.","73afe01565a44afaafc63a35ce2dd310ede16917":"Wenn du nicht warten möchtest, kannst du dein Canva Abonnement upgraden.","895614f2cf994b4946ca2184e7b046616cdc87c1":"Du kannst in Kürze wieder generieren","a26381a02e90572e5ecee4afc4a0e61dc624ed2e":"Canva Abonnement upgraden","a2dd6b941c70c2604f8dc9a9b4353d145a05973e":"Du hast dein monatliches KI-Limit deines Canva Abonnements fast erreicht","cdbc238349c8c293b1798c2c82a00c9cd5ee3e62":"Wenn du jetzt weiterarbeiten möchtest, kannst du dein Canva Abonnement jederzeit upgraden. Chatten kannst du aber auch so weiterhin.","d42af28f6e5d4c5d77cc1569df5c441254b88e0e":"In {0, plural, one {# Stunde} other {# Stunden}} kannst du wieder Inhalte generieren.","e3a4db9ef874c3da9944df106c9903e88ce6e71c":"Canva Abonnement ansehen","ff61e24bda9d6e39a78ae617aefaf3d5cff8b4ba":"Du hast das monatliche KI-Limit deines Canva Abonnements erreicht. Es wird am {0} zurückgesetzt."});

