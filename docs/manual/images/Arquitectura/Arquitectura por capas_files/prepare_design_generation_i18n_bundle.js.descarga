  Object.assign(strings["te-IN"], {"ea8b5db90463595c87a4e2b4d7d91a014a86fd72":"ఏదో సమస్య ఏర్పడింది","fcc3db92b4e7b3ca4eaecc599bcc56b0cc175318":"ఎర్రర్:","f54e454a5d3843e5dadc71623940d07f9fdd6bd8":"Canvaలో తెరవండి","39e0aaa6df8478bc5b723bad5d8f1edddb660e6c":"డిజైన్ ప్రివ్యూ","1db4e3a5a978a80a1f374b020092fbae4e17e6c0":"{0}వ పేజీ","2fddb161631952b973216d81f5cae49bb1e545fa":"రూపొందించిన డిజైన్","07a94cf04a82fa516d5c01bfaa14222881cc8f52":"పేరులేని డిజైన్","225934769fc7309b26395550e2f73f1a611ffa71":"ఫోటోల దృశ్య రూపకల్పన","28fed60d84f5540c47a91ceae8459b82e3cdefe1":"డిజైన్‌లు ఏవీ కనుగొనబడలేదు","460ad1ac76c9445555812ade28d3fcbb0ea426a7":"ప్రెజెంటేషన్","4c2a32f05250b0a3b37597eafeec795c8af4a655":"రిపోర్ట్","55a714344d60ff3bc7cf5b4e04d876b1a0a9445c":"డిజైన్ సూక్ష్మచిత్రం","6078acca22c4d622edc77ccc52921f62a202517f":"ఆహ్వానం","66a9cea0922de214504bd83067e3fc0ea748b002":"Facebook ముఖచిత్రం","6af42a3028a3d726f6d0966a4f05fbfcf9ccc0c5":"బిజినెస్ కార్డ్","6e9b8b013e243288508ed15beeb998e1d4174ce2":"కార్డ్","73613be70662d8b80435626ac4e2ee892d114541":"పోస్టర్","7615f8721ad7d71af0afd88c3fbde840b14352fa":"Facebook పోస్ట్","790f1261ff17bb0597939aed0f60c12d1812a648":"డాక్యుమెంట్","7f8172d1fa744c0d1e98d942838c67d724e4f042":"YouTube బ్యానర్","880ab1c7f585e309b9c2139d27814b423cb8ec16":"డెస్క్‌టాప్ వాల్‌పేపర్","9150ccb8ad68e33dc0c467ed8789184edc4951a8":"మీ కథనం","957e3943e6136bfff59e1df9495a4c91d31ecf3e":"YouTube సూక్ష్మచిత్రం","9e3e9b8a85ff36aabf4b113031f8babf57230a79":"రెజ్యూమ్","9f80ccca2df22d0af92dfb74393be27c168aaf87":"ఫోన్ వాల్‌పేపర్","b16eeaad26233ede794402ec8efbda2ffca79c3e":"Instagram పోస్ట్","b4ab580618c6122425c34f7802168303dd4ca649":"డిజైన్","b9443b025c5456adf1cfb586a1b97c3710ca0132":"Pinterest పిన్","c9794b6912aef4ea88686f04863e14041b8d87cd":"ఫ్లైయర్","cafaccac6247f9fca3e32f95d9d3c143c4328a87":"లోగో","dad9cc24373e66d7cd7f610128bde7a8615d2f5d":"సమాచార ప్రదర్శన చిత్రం","e05b209235b44bd3ffb83255e4ce73e94246191e":"Twitter పోస్ట్","fe1e5a32f67d497de920b4b7805fb1ffbf090fde":"పోస్ట్‌కార్డ్",