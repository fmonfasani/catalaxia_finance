 รายเดือนของแพลน Canva ครบแล้ว แต่คุณจะสร้างผลงานได้อีกในไม่ช้า","1f547fb99173dde3d5b1afe12853b20f537d6b90":"อัพเกรดเพื่อให้ใช้งานได้มากขึ้น","34b1b03f9bb0ef093be64edff26034f4b0b5e52c":"คุณจะกลับมาสร้างได้ในอีก {0, plural, one {# นาที} other {# นาที}}","73afe01565a44afaafc63a35ce2dd310ede16917":"ถ้าไม่อยากรอ อัพเกรด Canva แพลนของคุณได้เลย","895614f2cf994b4946ca2184e7b046616cdc87c1":"คุณจะสร้างได้อีกครั้งเร็วๆ นี้","a26381a02e90572e5ecee4afc4a0e61dc624ed2e":"อัพเกรด Canva แพลน","a2dd6b941c70c2604f8dc9a9b4353d145a05973e":"ใกล้หมดโควต้าใช้ AI รายเดือนของแพลน Canva ของคุณแล้ว","cdbc238349c8c293b1798c2c82a00c9cd5ee3e62":"ถ้าอยากดีไซน์ต่อที่นี่ คุณสามารถอัพเกรดแพลน Canva ของคุณได้ทุกเมื่อ หรือจะคุยกันต่อตามปกติก็ได้เช่นกัน","d42af28f6e5d4c5d77cc1569df5c441254b88e0e":"คุณจะกลับมาสร้างได้ในอีก {0, plural, one {# ชั่วโมง} other {# ชั่วโมง}}","e3a4db9ef874c3da9944df106c9903e88ce6e71c":"ดูแพลน Canva","ff61e24bda9d6e39a78ae617aefaf3d5cff8b4ba":"คุณใช้เครดิต AI รายเดือนของแพลน Canva ครบแล้ว จะรีเซ็ตในวันที่ {0}"});

