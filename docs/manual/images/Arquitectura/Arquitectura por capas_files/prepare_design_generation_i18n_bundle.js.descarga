6e96bda32cd244ed35d49f58b164d763":"டிசைன்கள் எதுவும் இல்லை. வேறு தேடலை முயலவும் அல்லது உங்கள் ஃபில்டர்களைச் சரிபார்க்கவும்.","ffea396f236c26a344f246f5b5e3092ed7ba2834":"பரிந்துரை","491965951445caee78af692681e8f80163c7a8e7":"உருவாக்கப்பட்ட டிசைன்","750c2467ff29e4b478a4c71812407774c368cef7":"தேடல் முடிவுகள்","40c0a8e05f22e5ce8134b205f812a84ed719948f":"பிராண்டு கிட்","95ad8a6305f0ec6f45c3a34c175c6d19f3a05fe3":"விளக்கப்பட அவுட்லைன்","10983722e7352c3731a37d66185be9fd07712ea7":"ஆச்சரியமானது","604cda0fa51d90eb175b727fc913a61671e6fa54":"பிராண்டு கிட்களைப் பயன்படுத்துவதற்குத் தேவையான அனுமதிகளை வழங்க, உங்களின் Canva கணக்கை மீண்டும் இணைக்கவும்.","7e456ac88dd85bce33811d48e67e1b692ff3b992":"ஸ்டைல் வகையைத் தேர்ந்தெடுக்கவும்","7fc2c7d02b486fbc3da5794bef53058bc89c6465":"ஸ்டைல்","a01cbc0df20e969f1ee19b810715a7616b339c52":"ஸ்டைல்","b6164529a7323e625c3e01af202eca6cac260abf":"பிராண்டைப் பயன்படுத்து","e2eb38ba2b17f573c3bed2b01d39297332177269":"ஆச்சரியமானது","1dfaa514e33478ba7a092a58f1a5ca66e215676c":"குறுகிய மற்றும் கூர்மை","1f3ad8dbe4025ec34a7519728b075b2892abf26d":"புரொஃபஷனல்","34647611c4addf4192616c8c103dbcec93bcdaef":"எலிகன்ட்","34eeeb0152e31a642b2d0c3ba94a49e53b048daf":"டிஜிட்டல்","38dfae483c93afc3800182482743bed04cbc3fb0":"மினிமலிஸ்ட்","38f5acc4dd4b1dca2a421b881171950f668e06aa":"வடிவியல்","6067cb1bb5f10466af06f39cb449ce7e447c5f60":"15+ ஸ்லைடுகள்","6c70a312f85238bc7e8f3afafde64882cd7b546d":"5 முதல் 15 ஸ்லைடுகள்","763679b3ee01193c36db861af5fc0bff8111c0a7":"குறுகியது","895352f526381153154fb2cd5c0b1ba2fb4e303d":"ஆர்கானிக்","8a9d663b33704c1a98ef38839dc424407c84782c":"சமச்சீர்","9385962c817ba267a90b1caeb52d884210dfefd8":"கல்வி","980db4c96bbc00a60d71c2af6148b50bdbd9afd9":"விரிவானது","a23e491b4b3d702423295bd9f2656fa132f9080d":"1 முதல் 5 ஸ்லைடுகள்","b7438a64ffbce12039049015d7252a63eb2a12a7":"கேஷூவல்","f1616f451b15faa57dedcbca527fb72d962e7c2e":"மாடுளர்","fff568edb20065da4f26d83b26fe46266b4018a6":"பிளேஃபுல்","0694f4fe85ba1c4e93d6e6d0a3aed8046dd150a5":"நீளத்தைத் தேர்ந்தெடுக்கவும்","1a97b1525fabc354f1a70c27b8e2b7d51414943c":"பார்வையாளர்கள்","67676d76c91cbffe8a6e88370d972a7ad832056d":"உருவாக்கு","8ee459a8f343aa0a9d4025b879b923852d80eb34":"டிசைனை உருவாக்கு","d0c2dab258b4f81dc9dc4314d986b4a507d5aa38":"பார்வையாளர்களைத் தேர்ந்தெடுக்கவும்","f449d12ccee28e65a8843a9a9e1f3696e361d332":"ஏதுமில்லை","fa668d76a86ceb24396fe06279fb9684b71c9026":"நீளம்","ca3c7cabb459b54b5d466d1cce4e3a3d334076cd":"பெயரிடப்படாத பிராண்டு கிட்","b651e5120ff2af53b24199e78456534de5d01f2a":"பிழை ஏற்பட்டது","f954d24e1ea694c491b5ece79f4c7c61b24ae099":"தேடல் முடிவுகள்","0d932a55aa933894731eb11de1d4cfa3b3867c1b":"PNG, JPEG அல்லது WEBP வடிவமைப்பைப் பதிவேற்ற முயலவும்.","0e2b28af1821f43bd03b6e69f668380e4f185a8a":"இந்த டிசைனைத் தனிப்பயனாக்கு","14ffa56620b4260c4e6f077c55e87ad982828988":"என் Canva திட்டத்தைக் காட்டு","16773b01365045e1bd255c78f8c8d67f4f0e29b7":"டிசைன் முன்னோட்டம்","1882887442ac288a0aee62cdfcc803660122c178":"அந்தப் படத்தை என்னால் பதிவேற்ற முடியவில்லை.","2f48ac19d532ccb5633b7b3816c9aad4862ffd02":"இங்கே விடவும்","311fdc413e003844429e8abd9f1551db93379e94":"வேறு படத்தைப் பயன்படுத்த முயலவும்.","43518a99c3ecc97fb02068f36187d3d8e508c6f1":"மிக அதிகமான படங்கள் பதிவேற்றப்பட்டன.","53e854e02a7368b93cf97f545a0cfe8e22cb9902":"ஒரே நேரத்தில் 1 படத்தைப் பதிவேற்ற முயலவும்.","5550805de7dc59777e627f6a14eeda11887ff476":"20MB ஐ விட சிறிய கோப்பைப் பதிவேற்ற முயலவும்.","6013959f924d60316d8843cd95b56f54d7be0b3b":"அந்தக் கோப்பு மிகவும் பெரியது.","63f0f32c190079d785af6169d4b69e2f8688597e":"மீண்டும் முயலவும்.","6f24bae8afa3ac4366e0cf17faba362ef78a017b":"அந்தக் கோப்பு வகை இணக்கமாக இல்லை.","7a8b7bb6f511c3fcfab1c4311bb8d23a7d6d3f14":"தனித்தனியான அல்லது AI ஆல் உருவாக்கப்பட்ட டிசைன்களை நீங்கள் கட்டுப்படுத்தும் வகையில் முழுமையாகத் திருத்தக்கூடிய தளவமைப்புகளாகப் பிரிக்கவும்.","7a8bc5bf9a36bf63f1a4fe12164ed26f6b2b7430":"அந்தக் கோப்பு மிகவும் சிறியது.","7f807ab43046658b13764fc360cd2a1f4ca5a9aa":"200px அல்லது அதற்கு மேற்பட்ட தெளிவுத்திறன் கொண்ட கோப்பைப் பதிவேற்ற முயலவும்.","80e8e3ad2290395d1035b67a4c3b2f614d7d122e":"உங்கள் கோப்பைத் திருத்தக்கூடிய தளவமைப்பாக உருமாற்றுகிறது. டிசைன்களை உருவாக்க 30 வினாடிகள் வரை ஆகலாம்...","941205410d2b5d8d664483c1cb953115c8b5624f":"பட முன்னோட்டம்","9df991668a3595c39c2e0a65dc434345c9e65ea5":"8096px அல்லது அதற்கும் குறைவான தெளிவுத்திறனில் கோப்பைப் பதிவேற்ற முயலவும்.","aca47d1f1c626567ac07132e84a979ef746e165d":"அகலமும் உயரமும் ஒன்றின் அளவை விட 3 மடங்குக்கு மேல் இருக்கக்கூடாது. உங்கள் படத்தைச் செதுக்க அல்லது அளவை மாற்ற, முயலவும்.","b41278895f3b3f7831832ca5a16a030e7c1fb519":"உங்கள் Canva திட்டத்தின் மாதாந்திர AI வரம்பை அடைந்துவிட்டீர்கள்.","d197280ac680083eb9e17f2e21d21000ace2d5a6":"அந்தப் படம் மிகவும் அகலமாக அல்லது உயரமாக உள்ளது.","daa868bfbe39dd54d18ca00dcc7546c9f5888e78":"அந்தக் கோப்பு மிகவும் பெரியது.","dbcaf6ba6adf02344c4d543baeebc3aaac8f828e":"ஃபிளாட் டிசைன்களைத் திருத்தக்கூடிய தளவமைப்புகளாக மாற்றவும்","ebc769732e8b6e5d30b8a7d6a50d658658ff043f":"ChatGPT மூலம் தொடர்ந்து உருவாக்க, நீங்கள் மேம்படுத்த வேண்டும். விருப்பங்களுக்கு, Canvaவில் உங்கள் திட்ட அமைப்புகளைப் பார்க்கவும்.","edff46869fb93010d6d2b03814a94de4ca5fb1c5":"மீடியாவைத் தேர்ந்தெடுக்கவும்","eedd60d044c7360cb6d3f071eb4ad3497edddebf":"அல்லது இங்கே இழுத்து விடவும்","fab1cead5083c225bb6aea6456253df5e139dc82":"அந்தப் படத்தைச் செயலாக்க முடியவில்லை.","0a2a295caf117f0169c47431723a04febe6a0a19":"Review and edit the outline via the chat below. When you ask for changes, Canva updates this preview by calling prepare-design-generation again with your revised outline.","847618964c808169e9ac260c824c650695be3c89":"கீழே உள்ள அரட்டை மூலம் அவுட்லைனை மதிப்பாய்வு செய்து திருத்தவும். நீங்கள் மாற்றங்களைக் கோரும்போது, உங்கள் திருத்தப்பட்ட அவுட்லைனுடன் மீண்டும் prepare-design-generation அம்சத்தை அழைத்து இந்த முன்னோட்டத்தை Canva புதுப்பிக்கும்.","99b7391b2436922e8af3d5364faf4c0f2b4d4402":"அவுட்லைனை மதிப்பாய்வு செய்யவும்","e07e9299d93ae924c639dc9defbce9fac6e493c2":"Review outline","371ed3a0d3fcf1e07f2ad1d3cb171e4f587f15af":"டிசைன்களை உருவாக்க முடியவில்லை. மீண்டும் முயலவும்.","89a94ee830eae913869fa2332b7aa426ea59117c":"டிசைன்கள் எதுவும் உருவாக்கப்படவில்லை. வேறு வினவலை முயலவும்.","dc72cd876fed54b4ad66fb8ae20ef47acd941aa4":"எதிர்பாராத பதில் வடிவமைப்பு பெறப்பட்டது. மீண்டும் முயலவும்.","3bb6fa2e1f7691afde1e4a249a3a0058804c7487":"டிசைனை நிறைவு செய்கிறோம். {0}","571e0bfcb732bdd4f651107823d193271610d894":"டிசைன்களை உருவாக்க 1 நிமிடம் வரை ஆகலாம்...","7dffc93456956a06337ea3e5da6d276dad632916":"உரை மற்றும் படங்களைச் சேர்க்கிறோம். {0}","8ec4cff9c1542e41e5c25c732c027434593a568c":"Canva டெம்ப்ளேட்களைத் தேடுகிறோம். {0}","f24fedc487af195ee38f774cc26564ab591f565c":"உங்கள் கதையைத் திட்டமிடுகிறோம். {0}","171b8bb4c77a7480fb0e4c4b29787c30bb5eca88":"இதுவரை நீங்கள் பயன்படுத்தியுள்ளதையும், உங்கள் பயன்பாட்டு வரம்பை எடுத்துக்கொள்ளும் AI அம்சங்களையும் அறிய, உங்கள் பயன்பாட்டைச் சரிபார்க்கவும்.","1f35e43b9b01eebaf477295061a5ebeb0a5a32c7":"உங்கள் Canva திட்டத்தின் மாதாந்திர AI வரம்பை அடைந்துவிட்டீர்கள். விரைவில் உங்களால் மீண்டும் உருவாக்க முடியும்.","1f547fb99173dde3d5b1afe12853b20f537d6b90":"மேலும் பெற, மேம்படுத்தவும்","34b1b03f9bb0ef093be64edff26034f4b0b5e52c":"நீங்கள் {0, plural, one {# நிமிடத்தில்} other {# நிமிடங்களில்}} மீண்டும் உருவாக்கலாம்.","73afe01565a44afaafc63a35ce2dd310ede16917":"காத்திருப்பைத் தவிர்க்க, உங்கள் Canva திட்டத்தை மேம்படுத்தவும்.","895614f2cf994b4946ca2184e7b046616cdc87c1":"விரைவில் உங்களால் மீண்டும் உருவாக்க முடியும்","a26381a02e90572e5ecee4afc4a0e61dc624ed2e":"Canva திட்டத்தை மேம்படுத்து","a2dd6b941c70c2604f8dc9a9b4353d145a05973e":"உங்கள் Canva திட்டத்தின் மாதாந்திர AI வரம்பை நெருங்கிவிட்டீர்கள்","cdbc238349c8c293b1798c2c82a00c9cd5ee3e62":"இங்கே தொடர்ந்து உருவாக்க, நீங்கள் உங்கள் Canva திட்டத்தை எப்போது வேண்டுமானாலும் மேம்படுத்தலாம். அல்லது வழக்கம் போல் அரட்டையடியுங்கள்.","d42af28f6e5d4c5d77cc1569df5c441254b88e0e":"நீங்கள் {0, plural, one {# மணிநேரத்தில்} other {# மணிநேரத்தில்}} மீண்டும் உருவாக்கலாம்","e3a4db9ef874c3da9944df106c9903e88ce6e71c":"Canva திட்டத்தைப் பார்க்கவும்","ff61e24bda9d6e39a78ae617aefaf3d5cff8b4ba":"உங்கள் Canva திட்டத்தின் மாதாந்திர AI வரம்பை அடைந்துவிட்டீர்கள். இது {0} அன்று மீட்டமைக்கப்படும்."});

