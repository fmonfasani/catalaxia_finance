<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://catalaxia/bpmn" id="defs_etl">
  <bpmn:collaboration id="col_etl">
    <bpmn:participant id="pool_etl" name="Pipeline ETL - Catalaxia" processRef="etl"/>
  </bpmn:collaboration>
  <bpmn:process id="etl" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="l_ext" name="1 Extraccion">
        <bpmn:flowNodeRef>etl_n1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>etl_n2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>etl_n3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>etl_n4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>etl_n5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_nor" name="2 Normalizacion e identidad">
        <bpmn:flowNodeRef>etl_n6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>etl_n7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_val" name="3 Unidad, moneda y validacion">
        <bpmn:flowNodeRef>etl_n8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>etl_n9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>etl_n10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>etl_n11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_der" name="4 Derivacion">
        <bpmn:flowNodeRef>etl_n12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>etl_n13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>etl_n14</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="l_pub" name="5 Publicacion">
        <bpmn:flowNodeRef>etl_n15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>etl_n16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>etl_n17</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="etl_n1" name="Corrida del pipeline">
      <bpmn:outgoing>etl_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="etl_n2" name="Bajar SEC EDGAR
(construir_base)">
      <bpmn:incoming>etl_f1</bpmn:incoming>
      <bpmn:outgoing>etl_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="etl_n3" name="Presento algo nuevo?">
      <bpmn:incoming>etl_f2</bpmn:incoming>
      <bpmn:outgoing>etl_f3</bpmn:outgoing>
      <bpmn:outgoing>etl_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="etl_n4" name="Bajar CNV
(job1..job8)">
      <bpmn:incoming>etl_f3</bpmn:incoming>
      <bpmn:outgoing>etl_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="etl_n5" name="Bajar MEP
(dolarito)">
      <bpmn:incoming>etl_f4</bpmn:incoming>
      <bpmn:incoming>etl_f5</bpmn:incoming>
      <bpmn:outgoing>etl_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="etl_n6" name="s0 Unir fuentes
y resolver identidad">
      <bpmn:incoming>etl_f6</bpmn:incoming>
      <bpmn:outgoing>etl_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="etl_n7" name="Calendario fiscal
(s2a)">
      <bpmn:incoming>etl_f7</bpmn:incoming>
      <bpmn:outgoing>etl_f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="etl_n8" name="s1 Bimoneda
+ banda por concepto">
      <bpmn:incoming>etl_f8</bpmn:incoming>
      <bpmn:outgoing>etl_f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="etl_n9" name="Coherencia interna">
      <bpmn:incoming>etl_f9</bpmn:incoming>
      <bpmn:outgoing>etl_f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="etl_n10" name="Certifica?">
      <bpmn:incoming>etl_f10</bpmn:incoming>
      <bpmn:outgoing>etl_f11</bpmn:outgoing>
      <bpmn:outgoing>etl_f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="etl_n11" name="Marcar y declarar
lo que no cierra">
      <bpmn:incoming>etl_f11</bpmn:incoming>
      <bpmn:outgoing>etl_f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="etl_n12" name="s2 Ratios CNV
(TTM)">
      <bpmn:incoming>etl_f12</bpmn:incoming>
      <bpmn:incoming>etl_f13</bpmn:incoming>
      <bpmn:outgoing>etl_f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="etl_n13" name="s4/s7 Ensamblar
y unificar">
      <bpmn:incoming>etl_f14</bpmn:incoming>
      <bpmn:outgoing>etl_f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="etl_n14" name="s7b PER
s7c CAGR USD
s7d dos fuentes">
      <bpmn:incoming>etl_f15</bpmn:incoming>
      <bpmn:outgoing>etl_f16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="etl_n15" name="s8 Calidad
s9 Guards">
      <bpmn:incoming>etl_f16</bpmn:incoming>
      <bpmn:outgoing>etl_f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="etl_n16" name="Publicar
screener / screener_v2">
      <bpmn:incoming>etl_f17</bpmn:incoming>
      <bpmn:outgoing>etl_f18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="etl_n17" name="Datos publicados">
      <bpmn:incoming>etl_f18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="etl_f1" sourceRef="etl_n1" targetRef="etl_n2"/>
    <bpmn:sequenceFlow id="etl_f2" sourceRef="etl_n2" targetRef="etl_n3"/>
    <bpmn:sequenceFlow id="etl_f3" name="si" sourceRef="etl_n3" targetRef="etl_n4"/>
    <bpmn:sequenceFlow id="etl_f4" name="no, ya esta al dia" sourceRef="etl_n3" targetRef="etl_n5"/>
    <bpmn:sequenceFlow id="etl_f5" sourceRef="etl_n4" targetRef="etl_n5"/>
    <bpmn:sequenceFlow id="etl_f6" sourceRef="etl_n5" targetRef="etl_n6"/>
    <bpmn:sequenceFlow id="etl_f7" sourceRef="etl_n6" targetRef="etl_n7"/>
    <bpmn:sequenceFlow id="etl_f8" sourceRef="etl_n7" targetRef="etl_n8"/>
    <bpmn:sequenceFlow id="etl_f9" sourceRef="etl_n8" targetRef="etl_n9"/>
    <bpmn:sequenceFlow id="etl_f10" sourceRef="etl_n9" targetRef="etl_n10"/>
    <bpmn:sequenceFlow id="etl_f11" name="hay dudas" sourceRef="etl_n10" targetRef="etl_n11"/>
    <bpmn:sequenceFlow id="etl_f12" name="todo cierra" sourceRef="etl_n10" targetRef="etl_n12"/>
    <bpmn:sequenceFlow id="etl_f13" sourceRef="etl_n11" targetRef="etl_n12"/>
    <bpmn:sequenceFlow id="etl_f14" sourceRef="etl_n12" targetRef="etl_n13"/>
    <bpmn:sequenceFlow id="etl_f15" sourceRef="etl_n13" targetRef="etl_n14"/>
    <bpmn:sequenceFlow id="etl_f16" sourceRef="etl_n14" targetRef="etl_n15"/>
    <bpmn:sequenceFlow id="etl_f17" sourceRef="etl_n15" targetRef="etl_n16"/>
    <bpmn:sequenceFlow id="etl_f18" sourceRef="etl_n16" targetRef="etl_n17"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="dia_etl">
    <bpmndi:BPMNPlane id="pla_etl" bpmnElement="col_etl">
      <bpmndi:BPMNShape id="sh_pool_etl" bpmnElement="pool_etl" isHorizontal="true">
        <dc:Bounds x="20" y="50" width="3433.0" height="650"/>
