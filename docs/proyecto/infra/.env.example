# Copiar a .env en /opt/catalaxia (NO commitear el .env real).
# Postgres (contenedor db)
POSTGRES_USER=catalaxia
POSTGRES_PASSWORD=cambiar-esto-por-uno-fuerte
POSTGRES_DB=catalaxia

# La API se conecta al servicio 'db' por el nombre de red de compose (host=db)
DATABASE_URL=postgresql+asyncpg://catalaxia:cambiar-esto-por-uno-fuerte@db:5432/catalaxia

# CORS: orígenes del frontend (local + producción)
CORS_ORIGINS=http://localhost:3000,https://catalaxia.<dominio>

# Opcional
API_ENV=production
