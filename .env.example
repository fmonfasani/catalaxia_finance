# PLANTILLA DE CONFIGURACION
# ==========================
# Copiar a `.env` y rellenar. El `.env` real NUNCA se sube al repositorio
# (este repositorio es publico), por eso existe esta plantilla: es la unica
# forma de saber que variables hay que definir en un servidor nuevo.
#
#     cp .env.example .env    &&    editar .env
#
# Aqui no va ningun valor real: solo el nombre de cada variable, para que sirve
# y de donde se saca.


# ── BASE DE DATOS ────────────────────────────────────────────────────────────

# La contrasena de PostgreSQL. docker-compose.yml la usa en tres servicios
# (postgres, pipeline y api), asi que sin esta variable `docker compose up`
# levanta la base con contrasena vacia.
# Generar una larga y al azar; no reutilizar ninguna de otro servicio.
POSTGRES_PASSWORD=

# Conexion desde el codigo Python. Con docker-compose, DB_HOST es el nombre del
# servicio (`postgres`), no `localhost`.
DB_TYPE=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=catalaxia
DB_USER=catalaxia
DB_PASSWORD=

# Solo para desarrollo local con SQLite: apunta a una copia de prueba en vez de
# a la base real. Todos los scripts que escriben en la base la respetan, y ese
# es justamente el punto -- si uno solo la ignora, escribe en la de verdad
# mientras el resto corre sobre la copia.
#     SCREENER_DB=screener.db.test
# En el servidor NO hace falta: alli se usa PostgreSQL.
SCREENER_DB=screener.db


# ── API ──────────────────────────────────────────────────────────────────────

# 127.0.0.1 solo acepta conexiones de la propia maquina. Detras de nginx esta
# bien; si la API tiene que ser accesible desde fuera sin proxy, va 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8100

# Seguridad del API (F10):
#   API_KEY: clave requerida via header `X-API-Key` en TODOS los endpoints.
#            Sin valor el API responde 503 (fail-closed): nunca abre por default.
#   API_CORS_ORIGINS: origenes cross-origin permitidos separados por coma.
#            Vacio = solo mismo-origen. "*" permite cualquiera SIN credenciales.
# Generar la clave con:  openssl rand -base64 32
API_KEY=
API_CORS_ORIGINS=


# ── ENGINE / PIPELINE E2E CERTIFICADO (S00→C12) ─────────────────────────────

# Cadena completa del engine, en contenedor:
#     docker compose --profile run-e2e run --rm engine
# En docker-compose.yml el servicio `engine` conecta al rol no-superusuario
# `catalaxia_engine` (F-025 / migracion 011) usando como password la de
# POSTGRES_PASSWORD. No hace falta declarar ENGINE_* en .env salvo override:

# PASSWORD del rol de aplicacion. Si la base no la tiene, el entrypoint la
# asigna por bootstrap administrativo (ALTER ROLE ... PASSWORD con la
# variable ENGINE_ADMIN_DB_PASSWORD); nunca va en migraciones ni en el repo.
#     ENGINE_DB_PASSWORD=

# Modo de la cadena: FAST | FULL | AUDIT (default FAST).
#     ENGINE_MODE=FAST

# Trueque de staging (C12) a nivel de invariantes de corrida; default 1:
#     ENGINE_STATEMENT_TIMEOUT_MS=300000

# ── FUENTES EXTERNAS ─────────────────────────────────────────────────────────

# Token del header `auth-client` de la API de dolarito.ar, de donde sale la
# serie del dolar MEP (tabla dolarito_cotizaciones).
# Se obtiene mirando el header que manda www.dolarito.ar en el navegador.
# Sin esto, fetch_dolarito_historico.py se detiene con un mensaje que lo explica.
DOLARITO_AUTH_CLIENT=


# ── DEPLOY / SINCRONIZACION A PRODUCCION ─────────────────────────────────

# R2 (cero secretos en codigo): sin valores reales aqui, solo el nombre.
# Son OBLIGATORIAS: deploy.py, deploy_production.sh y
# sincronizar_a_produccion.py fallan TEMPRANO si faltan (sin default silencioso).
CATALAXIA_HOST=
CATALAXIA_SSH_USER=
CATALAXIA_SSH_TARGET=
CATALAXIA_API_URL=
CATALAXIA_DASHBOARD_URL=

# Opcionales NO sensibles (con default dev documentado en el codigo):
# CATALAXIA_SERVER_PATH=/opt/catalaxia
# CATALAXIA_DB_CONTAINER=catalaxia-db
# CATALAXIA_PG_USER=catalaxia
# CATALAXIA_PG_DB=catalaxia
# CATALAXIA_SSH_KEY=$HOME/.ssh/id_rsa
