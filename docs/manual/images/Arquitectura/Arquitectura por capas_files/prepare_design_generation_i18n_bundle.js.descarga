  Object.assign(strings["ja-Heisei"], {"ea8b5db90463595c87a4e2b4d7d91a014a86fd72":"問題が発生しました","fcc3db92b4e7b3ca4eaecc599bcc56b0cc175318":"エラー：","f54e454a5d3843e5dadc71623940d07f9fdd6bd8":"Canvaで開く","39e0aaa6df8478bc5b723bad5d8f1edddb660e6c":"デザインのプレビュー","1db4e3a5a978a80a1f374b020092fbae4e17e6c0":"{0}ページ","2fddb161631952b973216d81f5cae49bb1e545fa":"デザインを生成しました","07a94cf04a82fa516d5c01bfaa14222881cc8f52":"名称未設定のデザイン","225934769fc7309b26395550e2f73f1a611ffa71":"写真コラージュ","28fed60d84f5540c47a91ceae8459b82e3cdefe1":"デザインがありません","460ad1ac76c9445555812ade28d3fcbb0ea426a7":"プレゼンテーション","4c2a32f05250b0a3b37597eafeec795c8af4a655":"レポート","55a714344d60ff3bc7cf5b4e04d876b1a0a9445c":"サムネイルをデザイン","6078acca22c4d622edc77ccc52921f62a202517f":"招待状","66a9cea0922de214504bd83067e3fc0ea748b002":"Facebookカバー","6af42a3028a3d726f6d0966a4f05fbfcf9ccc0c5":"名刺","6e9b8b013e243288508ed15beeb998e1d4174ce2":"カード","73613be70662d8b80435626ac4e2ee892d114541":"ポスター","7615f8721ad7d71af0afd88c3fbde840b14352fa":"Facebookの投稿","790f1261ff17bb0597939aed0f60c12d1812a648":"ドキュメント","7f8172d1fa744c0d1e98d942838c67d724e4f042":"YouTubeバナー","880ab1c7f585e309b9c2139d27814b423cb8ec16":"デスクトップ壁紙","9150ccb8ad68e33dc0c467ed8789184edc4951a8":"ストーリー","957e3943e6136bfff59e1df9495a4c91d31ecf3e":"YouTubeサムネイル","9e3e9b8a85ff36aabf4b113031f8babf57230a79":"履歴書・職務経歴書","9f80ccca2df22d0af92dfb74393be27c168aaf87":"スマホの壁紙","b16eeaad26233ede794402ec8efbda2ffca79c3e":"Instagramの投稿","b4ab580618c6122425c34f7802168303dd4ca649":"デザイン","b9443b025c5456adf1cfb586a1b97c3710ca0132":"Pinterestピン","c9794b6912aef4ea88686f04863e14041b8d87cd":"チラシ","cafaccac6247f9fca3e32f95d9d3c143c4328a87":"ロゴ","dad9cc24373e66d7cd7f610128bde7a8615d2f5d":"インフォグラフィック","e05b209235b44bd3ffb83255e4ce73e94246191e":"X/Twitter投稿","fe1e5a32f67d497de920b4b7805fb1ffbf090fde":"ポストカード","ffe6e7986e96bda32cd244ed35d49f58b164d763":"デザインが見つかりませんでした。別の検索を試すか、フィルターを確認してください。","ffea396f236c26a344f246f5b5e3092ed7ba2834":"提案書・企画書","491965951445caee78af692681e8f80163c7a8e7":"デザインを生成しました","750c2467ff29e4b478a4c71812407774c368cef7":"検索結果","40c0a8e05f22e5ce8134b205f812a84ed719948f":"ブランドキット","95ad8a6305f0ec6f45c3a34c175c6d19f3a05fe3":"プレゼンテーションのアウトライン","10983722e7352c3731a37d66185be9fd07712ea7":"おすすめを生成","604cda0fa51d90eb175b727fc913a61671e6fa54":"ブランドキットを使用するには、必要な権限を付与するためにCanvaアカウントを再接続してください。","7e456ac88dd85bce33811d48e67e1b692ff3b992":"スタイルの種類を選択","7fc2c7d02b486fbc3da5794bef53058bc89c6465":"スタイル","a01cbc0df20e969f1ee19b810715a7616b339c52":"スタイル","b6164529a7323e625c3e01af202eca6cac260abf":"ブランドを適用","e2eb38ba2b17f573c3bed2b01d39297332177269":"おすすめを生成","1dfaa514e33478ba7a092a58f1a5ca66e215676c":"簡潔","1f3ad8dbe4025ec34a7519728b075b2892abf26d":"ビジネス・公式","34647611c4addf4192616c8c103dbcec93bcdaef":"エレガント","34eeeb0152e31a642b2d0c3ba94a49e53b048daf":"デジタル","38dfae483c93afc3800182482743bed04cbc3fb0":"ミニマル","38f5acc4dd4b1dca2a421b881171950f668e06aa":"幾何学的","6067cb1bb5f10466af06f39cb449ce7e447c5f60":"15枚以上のスライド","6c70a312f85238bc7e8f3afafde64882cd7b546d":"5～15枚のスライド","763679b3ee01193c36db861af5fc0bff8111c0a7":"短い","895352f526381153154fb2cd5c0b1ba2fb4e303d":"有機的","8a9d663b33704c1a98ef38839dc424407c84782c":"標準","9385962c817ba267a90b1caeb52d884210dfefd8":"教育","980db4c96bbc00a60d71c2af6148b50bdbd9afd9":"詳細","a23e491b4b3d702423295bd9f2656fa132f9080d":"1～5枚のスライド","b7438a64ffbce12039049015d7252a63eb2a12a7":"カジュアル","f1616f451b15faa57dedcbca527fb72d962e7c2e":"モジュール","fff568edb20065da4f26d83b26fe46266b4018a6":"プレイフル","0694f4fe85ba1c4e93d6e6d0a3aed8046dd150a5":"長さを選択","1a97b1525fabc354f1a70c27b8e2b7d51414943c":"対象者","67676d76c91cbffe8a6e88370d972a7ad832056d":"生成","8ee459a8f343aa0a9d4025b879b923852d80eb34":"デザインを生成","d0c2dab258b4f81dc9dc4314d986b4a507d5aa38":"対象者を選択","f449d12ccee28e65a8843a9a9e1f3696e361d332":"なし","fa668d76a86ceb24396fe06279fb9684b71c9026":"長さ","ca3c7cabb459b54b5d466d1cce4e3a3d334076cd":"名称未設定のブランドキット","b651e5120ff2af53b24199e78456534de5d01f2a":"エラーが発生しました","f954d24e1ea694c491b5ece79f4c7c61b24ae099":"検索結果","0d932a55aa933894731eb11de1d4cfa3b3867c1b":"PNG、JPEG、またはWEBP形式でアップロードしてみてください。","0e2b28af1821f43bd03b6e69f668380e4f185a8a":"このデザインをカスタマイズ","14ffa56620b4260c4e6f077c55e87ad982828988":"Canvaのプランを確認","16773b01365045e1bd255c78f8c8d67f4f0e29b7":"デザインのプレビュー","1882887442ac288a0aee62cdfcc803660122c178":"その画像をアップロードできませんでした。","2f48ac19d532ccb5633b7b3816c9aad4862ffd02":"ここにドロップ","311fdc413e003844429e8abd9f1551db93379e94":"別の画像をお試しください。","43518a99c3ecc97fb02068f36187d3d8e508c6f1":"アップロードされた画像が多すぎます。","53e854e02a7368b93cf97f545a0cfe8e22cb9902":"画像を1枚ずつアップロードしてください。","5550805de7dc59777e627f6a14eeda11887ff476":"20MB未満のファイルをアップロードしてみてください。","6013959f924d60316d8843cd95b56f54d7be0b3b":"そのファイルは大きすぎます。","63f0f32c190079d785af6169d4b69e2f8688597e":"もう一度お試しください。","6f24bae8afa3ac4366e0cf17faba362ef78a017b":"そのファイルタイプは対応していません。","7a8b7bb6f511c3fcfab1c4311bb8d23a7d6d3f14":"身の回りの写真やフラット化された画像、AIで生成されたデザインを、自由に編集可能なレイヤーにします。","7a8bc5bf9a36bf63f1a4fe12164ed26f6b2b7430":"そのファイルは小さすぎます。","7f807ab43046658b13764fc360cd2a1f4ca5a9aa":"解像度が200px以上のファイルをアップロードしてみてください。","80e8e3ad2290395d1035b67a4c3b2f614d7d122e":"ファイルを編集可能なレイアウトに変換します。デザインの生成には最大30秒かかる場合があります...","941205410d2b5d8d664483c1cb953115c8b5624f":"画像のプレビュー","9df991668a3595c39c2e0a65dc434345c9e65ea5":"解像度が8096px以下のファイルをアップロードしてみてください。","aca47d1f1c626567ac07132e84a979ef746e165d":"幅と高さの比率は、互いに3倍以内である必要があります。画像の切り抜きやサイズ変更を試してください。","b41278895f3b3f7831832ca5a16a030e7c1fb519":"Canvaプランの月間AI利用上限に達しました。","d197280ac680083eb9e17f2e21d21000ace2d5a6":"その画像は幅または高さが制限を超えています。","daa868bfbe39dd54d18ca00dcc7546c9f5888e78":"そのファイルは大きすぎます。","dbcaf6ba6adf02344c4d543baeebc3aaac8f828e":"フラットなデザインを編集可能なレイアウトに変換","ebc769732e8b6e5d30b8a7d6a50d658658ff043f":"ChatGPTで作成を続けるには、アップグレードが必要になる場合があります。利用可能なプランについては、Canvaのプラン設定をご確認ください。","edff46869fb93010d6d2b03814a94de4ca5fb1c5":"メディアを選択","eedd60d044c7360cb6d3f071eb4ad3497edddebf":"またはこちらにドラッグ&ドロップ","fab1cead5083c225bb6aea6456253df5e139dc82":"この画像は処理できませんでした。","0a2a295caf117f0169c47431723a04febe6a0a19":"Review and edit the outline via the chat below. When you ask for changes, Canva updates this preview by calling prepare-design-generation again with your revised outline.","847618964c808169e9ac260c824c650695be3c89":"以下のチャットでアウトラインを確認・編集してください。変更を申請すると、Canvaは、修正したアウトラインを使ってprepare-design-generationを再度呼び出すことにより、このプレビューを更新します。","99b7391b2436922e8af3d5364faf4c0f2b4d4402":"アウトラインを確認","e07e9299d93ae924c639dc9defbce9fac6e493c2":"Review outline","371ed3a0d3fcf1e07f2ad1d3cb171e4f587f15af":"デザインの生成に失敗しました。もう一度お試しください。","89a94ee830eae913869fa2332b7aa426ea59117c":"デザインが生成されませんでした。別のクエリでお試しください。","dc72cd876fed54b4ad66fb8ae20ef47acd941aa4":"予期しないレスポンス形式を受信しました。もう一度お試しください。","3bb6fa2e1f7691afde1e4a249a3a0058804c7487":"デザインを仕上げています。{0}","571e0bfcb732bdd4f651107823d193271610d894":"デザインの生成には1分程度かかる場合があります...","7dffc93456956a06337ea3e5da6d276dad632916":"テキストと画像を追加しています。{0}","8ec4cff9c1542e41e5c25c732c027434593a568c":"Canvaテンプレートを検索しています。{0}","f24fedc487af195ee38f774cc26564ab591f565c":"ストーリーを計画しています。{0}","171b8bb4c77a7480fb0e4c4b29787c30bb5eca88":"これまでの利用回数や、利用制限を著しく消費するAI機能をご確認ください。","1f35e43b9b01eebaf477295061a5ebeb0a5a32c7":"Canvaプランの月間AI利用上限に達しました。すぐに再び生成できるようになります。","1f547fb99173dde3d5b1afe12853b20f537d6b90":"アップグレードしてさらに利用","34b1b03f9bb0ef093be64edff26034f4b0b5e52c":"{0, plural, one {#分} other {#分}}後に再度生成できます","73afe01565a44afaafc63a35ce2dd310ede16917":"待たずに再度生成するには、ご利用中のCanvaプランをアップグレードしてください。","895614f2cf994b4946ca2184e7b046616cdc87c1":"すぐに再生成できるようになります","a26381a02e90572e5ecee4afc4a0e61dc624ed2e":"Canvaプランをアップグレード","a2dd6b941c70c2604f8dc9a9b4353d145a05973e":"Canvaプランの月間AI利用上限に近づいています","cdbc238349c8c293b1798c2c82a00c9cd5ee3e62":"作成を今続行するには、ご利用中のCanvaプランをアップグレードしてください。アップグレードはいつでも可能です。また、チャット機能は引き続きご利用いただけます。","d42af28f6e5d4c5d77cc1569df5c441254b88e0e":"{0, plural, one {#時間} other {#時間}}後に再度生成できます","e3a4db9ef874c3da9944df106c9903e88ce6e71c":"Canvaプランを見る","ff61e24bda9d6e39a78ae617aefaf3d5cff8b4ba":"Canvaプランの月間AI利用上限に達しました。{0}にリセットされます。"});

