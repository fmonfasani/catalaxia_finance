,"67676d76c91cbffe8a6e88370d972a7ad832056d":"Gerar","8ee459a8f343aa0a9d4025b879b923852d80eb34":"Gerar design","d0c2dab258b4f81dc9dc4314d986b4a507d5aa38":"Selecione o público","f449d12ccee28e65a8843a9a9e1f3696e361d332":"Nenhuma","fa668d76a86ceb24396fe06279fb9684b71c9026":"Comprimento","ca3c7cabb459b54b5d466d1cce4e3a3d334076cd":"Kit de marca sem nome","b651e5120ff2af53b24199e78456534de5d01f2a":"Ocorreu um erro","f954d24e1ea694c491b5ece79f4c7c61b24ae099":"Resultados da busca","0d932a55aa933894731eb11de1d4cfa3b3867c1b":"Faça upload de um arquivo em formato PNG, JPEG ou WEBP.","0e2b28af1821f43bd03b6e69f668380e4f185a8a":"Personalize esse design","14ffa56620b4260c4e6f077c55e87ad982828988":"Ver meu plano do Canva","16773b01365045e1bd255c78f8c8d67f4f0e29b7":"Pré-visualização do design","1882887442ac288a0aee62cdfcc803660122c178":"Não foi possível fazer upload da imagem.","2f48ac19d532ccb5633b7b3816c9aad4862ffd02":"Arraste para cá","311fdc413e003844429e8abd9f1551db93379e94":"Tente usar uma imagem diferente.","43518a99c3ecc97fb02068f36187d3d8e508c6f1":"Você fez upload de imagens demais.","53e854e02a7368b93cf97f545a0cfe8e22cb9902":"Faça upload de uma imagem de cada vez.","5550805de7dc59777e627f6a14eeda11887ff476":"Faça upload de um arquivo com menos de 20 MB.","6013959f924d60316d8843cd95b56f54d7be0b3b":"Esse arquivo é muito grande.","63f0f32c190079d785af6169d4b69e2f8688597e":"Tente de novo.","6f24bae8afa3ac4366e0cf17faba362ef78a017b":"Esse tipo de arquivo não é compatível.","7a8b7bb6f511c3fcfab1c4311bb8d23a7d6d3f14":"Separe designs planos ou gerados por IA em layouts totalmente editáveis.","7a8bc5bf9a36bf63f1a4fe12164ed26f6b2b7430":"Esse arquivo é muito pequeno.","7f807ab43046658b13764fc360cd2a1f4ca5a9aa":"Faça upload de um arquivo com uma resolução de 200 px ou mais.","80e8e3ad2290395d1035b67a4c3b2f614d7d122e":"Transformando seu arquivo em um layout editável. A geração de designs pode levar até 30 segundos...","941205410d2b5d8d664483c1cb953115c8b5624f":"Pré-visualização da imagem","9df991668a3595c39c2e0a65dc434345c9e65ea5":"Faça upload de um arquivo com uma resolução de 8096 px ou menos.","aca47d1f1c626567ac07132e84a979ef746e165d":"A largura e a altura não podem ter mais de três vezes o tamanho uma da outra. Experimente cortar ou redimensionar a sua imagem.","b41278895f3b3f7831832ca5a16a030e7c1fb519":"Você atingiu o limite mensal de uso da IA do seu plano do Canva.","d197280ac680083eb9e17f2e21d21000ace2d5a6":"Essa imagem é muito larga ou alta.","daa868bfbe39dd54d18ca00dcc7546c9f5888e78":"Esse arquivo é muito grande.","dbcaf6ba6adf02344c4d543baeebc3aaac8f828e":"Transforme designs planos em layouts editáveis","ebc769732e8b6e5d30b8a7d6a50d658658ff043f":"Para continuar criando com o ChatGPT, talvez você precise fazer upgrade. Para ver as opções, consulte as configurações do seu plano do Canva.","edff46869fb93010d6d2b03814a94de4ca5fb1c5":"Selecionar item de mídia","eedd60d044c7360cb6d3f071eb4ad3497edddebf":"ou arraste e solte aqui","fab1cead5083c225bb6aea6456253df5e139dc82":"Não foi possível processar essa imagem.","0a2a295caf117f0169c47431723a04febe6a0a19":"Review and edit the outline via the chat below. When you ask for changes, Canva updates this preview by calling prepare-design-generation again with your revised outline.","847618964c808169e9ac260c824c650695be3c89":"Revise e edite o índice usando o chat abaixo. Quando você solicitar alterações, o Canva atualizará essa pré-visualização acessando prepare-design-generation de novo com o seu esboço revisado.","99b7391b2436922e8af3d5364faf4c0f2b4d4402":"Revisar índice","e07e9299d93ae924c639dc9defbce9fac6e493c2":"Review outline","371ed3a0d3fcf1e07f2ad1d3cb171e4f587f15af":"Não foi possível gerar os designs. Tente de novo.","89a94ee830eae913869fa2332b7aa426ea59117c":"Nenhum design foi gerado. Tente usar uma consulta diferente.","dc72cd876fed54b4ad66fb8ae20ef47acd941aa4":"A resposta recebida não tem o formato esperado. Tente de novo.","3bb6fa2e1f7691afde1e4a249a3a0058804c7487":"Finalizando o design. {0}","571e0bfcb732bdd4f651107823d193271610d894":"A geração de designs pode levar até 1 minuto...","7dffc93456956a06337ea3e5da6d276dad632916":"Adicionando texto e imagens. {0}","8ec4cff9c1542e41e5c25c732c027434593a568c":"Buscando modelos do Canva. {0}","f24fedc487af195ee38f774cc26564ab591f565c":"Planejando seu story. {0}","171b8bb4c77a7480fb0e4c4b29787c30bb5eca88":"Verifique quanto você já usou até o momento e os recursos de IA que consomem o seu limite.","1f35e43b9b01eebaf477295061a5ebeb0a5a32c7":"Você atingiu o limite mensal de uso da IA do seu plano do Canva. Você poderá voltar a gerar conteúdo em breve.","1f547fb99173dde3d5b1afe12853b20f537d6b90":"Faça upgrade para aumentar o limite","34b1b03f9bb0ef093be64edff26034f4b0b5e52c":"Você pode voltar a gerar em {0, plural, one {# minuto} other {# minutos}}","73afe01565a44afaafc63a35ce2dd310ede16917":"Para não ter que esperar, faça upgrade do seu plano do Canva.","895614f2cf994b4946ca2184e7b046616cdc87c1":"Você poderá gerar conteúdo de novo em breve","a26381a02e90572e5ecee4afc4a0e61dc624ed2e":"Faça upgrade do seu plano do Canva","a2dd6b941c70c2604f8dc9a9b4353d145a05973e":"Você está prestes a atingir o limite mensal de uso da IA do seu plano do Canva","cdbc238349c8c293b1798c2c82a00c9cd5ee3e62":"Para continuar criando aqui, você pode fazer upgrade do seu plano do Canva quando quiser. Ou podemos continuar conversando normalmente.","d42af28f6e5d4c5d77cc1569df5c441254b88e0e":"Você pode voltar a gerar em {0, plural, one {# hora} other {# horas}}","e3a4db9ef874c3da9944df106c9903e88ce6e71c":"Ver plano do Canva","ff61e24bda9d6e39a78ae617aefaf3d5cff8b4ba":"Você atingiu o limite mensal de uso da IA do seu plano do Canva. Ele se renova em {0}."});

