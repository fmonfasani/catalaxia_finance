ur image.","b41278895f3b3f7831832ca5a16a030e7c1fb519":"You’ve hit your Canva plan’s monthly AI limit.","d197280ac680083eb9e17f2e21d21000ace2d5a6":"That image is too wide or tall.","daa868bfbe39dd54d18ca00dcc7546c9f5888e78":"That file is too large.","dbcaf6ba6adf02344c4d543baeebc3aaac8f828e":"Turn flat designs into editable layouts","ebc769732e8b6e5d30b8a7d6a50d658658ff043f":"To keep creating with ChatGPT, you may need to upgrade. For options, check your plan settings in Canva.","edff46869fb93010d6d2b03814a94de4ca5fb1c5":"Select media","eedd60d044c7360cb6d3f071eb4ad3497edddebf":"or drag and drop here","fab1cead5083c225bb6aea6456253df5e139dc82":"That image couldn’t be processed.","0a2a295caf117f0169c47431723a04febe6a0a19":"Review and edit the outline via the chat below. When you ask for changes, Canva updates this preview by calling prepare-design-generation again with your revised outline.","847618964c808169e9ac260c824c650695be3c89":"Review and edit the outline via the chat below. When you ask for changes, Canva updates this preview by calling prepare-design-generation again with your revised outline.","99b7391b2436922e8af3d5364faf4c0f2b4d4402":"Review outline","e07e9299d93ae924c639dc9defbce9fac6e493c2":"Review outline","371ed3a0d3fcf1e07f2ad1d3cb171e4f587f15af":"Failed to generate designs. Please try again.","89a94ee830eae913869fa2332b7aa426ea59117c":"No designs were generated. Please try a different query.","dc72cd876fed54b4ad66fb8ae20ef47acd941aa4":"Received unexpected response format. Please try again.","3bb6fa2e1f7691afde1e4a249a3a0058804c7487":"Finalizing design. {0}","571e0bfcb732bdd4f651107823d193271610d894":"Generating designs can take up to 1 minute...","7dffc93456956a06337ea3e5da6d276dad632916":"Adding text and images. {0}","8ec4cff9c1542e41e5c25c732c027434593a568c":"Searching Canva templates. {0}","f24fedc487af195ee38f774cc26564ab591f565c":"Planning your story. {0}","171b8bb4c77a7480fb0e4c4b29787c30bb5eca88":"Check your usage to see what you’ve used so far, plus the AI features that use up your limit.","1f35e43b9b01eebaf477295061a5ebeb0a5a32c7":"You’ve reached your Canva plan’s monthly AI limit. You’ll be able to generate again soon.","1f547fb99173dde3d5b1afe12853b20f537d6b90":"Upgrade for more","34b1b03f9bb0ef093be64edff26034f4b0b5e52c":"You can generate again in {0, plural, one {# minute} other {# minutes}}","73afe01565a44afaafc63a35ce2dd310ede16917":"To skip the wait, upgrade your Canva plan.","895614f2cf994b4946ca2184e7b046616cdc87c1":"You’ll be able to generate again soon","a26381a02e90572e5ecee4afc4a0e61dc624ed2e":"Upgrade Canva plan","a2dd6b941c70c2604f8dc9a9b4353d145a05973e":"You’re getting close to your Canva plan’s monthly AI limit","cdbc238349c8c293b1798c2c82a00c9cd5ee3e62":"To keep creating here, you can upgrade your Canva plan any time. Or, keep chatting as normal.","d42af28f6e5d4c5d77cc1569df5c441254b88e0e":"You can generate again in {0, plural, one {# hour} other {# hours}}","e3a4db9ef874c3da9944df106c9903e88ce6e71c":"View Canva plan","ff61e24bda9d6e39a78ae617aefaf3d5cff8b4ba":"You’ve reached your Canva plan’s monthly AI limit. It resets on {0}."});

